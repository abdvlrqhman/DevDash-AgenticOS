<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Downloads are saved in the app's Documents folder; these show it in the Files app (On My iPhone › DevDash). -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Voice mode: without it the web view offers pages no microphone at all (navigator.mediaDevices is undefined). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>DevDash uses the microphone for voice mode, when you tap the mic to talk to Hamasa or a session.</string>
</dict>
</plist>
