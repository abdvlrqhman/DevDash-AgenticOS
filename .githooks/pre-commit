#!/bin/sh
# Blocks commits that contain secrets. Enabled per clone with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required (https://github.com/gitleaks/gitleaks#installing)" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
